# Copie este arquivo para .env.local e preencha.
# A chave fica SÓ no servidor (rota /api/azimuth). Nunca use o prefixo NEXT_PUBLIC_ aqui.

# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini (opcional). Padrão: gemini-3.5-flash (reservas automáticas: 3.1-flash-lite, 2.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# true = força o plano B (respostas pré-escritas, sem rede). Útil para gravar o vídeo.
AZIMUTH_OFFLINE=false
